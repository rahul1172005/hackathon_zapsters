# Application
ENV=development
SECRET_KEY=change-me-to-a-random-64-character-secret

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://zapsters:zapsters@localhost:5432/zapsters

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh token cookie
REFRESH_COOKIE_NAME=zapsters_refresh

# Uploads
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_PER_USER_QUOTA_MB=100

# Discord bridge
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENT_WEBHOOK_URL=
BACKEND_BASE_URL=http://localhost:8000
